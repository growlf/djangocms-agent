# Copy to .env and export the values (the settings read the process environment; .env is gitignored).
# Development only: DJANGO_DEBUG=1 enables a built-in insecure dev key and the debug toolbar.
DJANGO_DEBUG=0
# Only matters when DJANGO_DEBUG=1: set to 0 to hide the debug-toolbar handle (green tab, right edge).
# DJANGO_DEBUG_TOOLBAR=1
# Required when DJANGO_DEBUG is off. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma separated host names, required when DJANGO_DEBUG is off. localhost and 127.0.0.1 are always
# added (the container healthcheck uses 127.0.0.1) but listing them keeps the intent visible.
DJANGO_ALLOWED_HOSTS=example.org,localhost,127.0.0.1
# Domain stored on the django Site by the seed commands (admin 'View site', toolbar). Default localhost.
# SITE_DOMAIN=localhost
# Optional: enables the Google Map plugin (offered to editors only with a key) and its sample on the Style page.
GOOGLE_MAPS_API_KEY=

# --- Docker + PostgreSQL (see README "Docker + PostgreSQL") ---
# bin/docker-env.sh creates .env with random values for the two secrets below if .env is absent.
DB_NAME=__PROJECT_NAME__
DB_USER=__PROJECT_NAME__
DB_PASSWORD=change-me
# Host port and bind address of the app container (default 127.0.0.1:8889).
# APP_PORT=8889
# APP_BIND=127.0.0.1
# Must list the origin(s) users browse to, with scheme AND port, when APP_PORT/host/proxy differ.
# The compose default follows APP_PORT for localhost and 127.0.0.1 only.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8889
# Set to 1 behind a TLS-terminating proxy that sets (and strips client-sent) X-Forwarded-Proto.
# Never combine it with APP_BIND=0.0.0.0 unless only that proxy can reach the port.
# DJANGO_BEHIND_PROXY=0
# Number of reverse proxies in front of the app (only used with DJANGO_BEHIND_PROXY=1): the login throttle
# takes the client address from the RIGHT of X-Forwarded-For, that many hops in. Without the proxy flag
# X-Forwarded-For is ignored (a client could otherwise forge it).
# DJANGO_PROXY_COUNT=1
# Login throttling (django-axes): lock a username+IP after N failed admin/CMS logins for M minutes.
# DJANGO_LOGIN_FAILURE_LIMIT=5      # 0 turns throttling off
# DJANGO_LOGIN_COOLOFF_MINUTES=60   # 0 = locked until an operator runs `manage.py axes_reset`
# DJANGO_LOGIN_LOCKOUT_BY=ip_username   # or `ip` (all users behind one address share the counter)
# Behind a proxy (above) the session, CSRF and language cookies are marked Secure. Optional extras:
# DJANGO_HSTS_SECONDS=0              # e.g. 31536000 once https works; sticky in browsers
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SSL_REDIRECT=0              # redirect http to https (proxy must send X-Forwarded-Proto); /health/ is exempt
# Shared cache: with PostgreSQL the default cache is a database table shared by all gunicorn
# workers (createcachetable runs at start). Set locmem only for a single-worker setup.
# DJANGO_CACHE=db
# Repair content that predates versioning: set both ONCE, restart, then unset CREATE_VERSIONS.
# CREATE_VERSIONS=0
# CREATE_VERSIONS_USER=admin
# Serve /media/ from Django when DEBUG is off (compose default 1). Set 0 when a proxy serves /media/.
# DJANGO_SERVE_MEDIA=1
# 1 = seed a FRESH database once at start (`manage.py seed --first-run-only`: skipped when the home page
# exists, so restarts never refill placeholders an editor emptied). Default 0.
# SEED_ON_START=0

# --- Dev stack (docker-compose.dev.yml, bin/dev-up.sh) ---
# DEV_PORT=8880
# APP_UID=1000
# --- Releases ---
# Images are pinned by digest; bin/pin-images.sh refreshes them (bin/release.sh does it for every vX.Y.Z).
# APP_VERSION=latest   # tag of the app image: __PROJECT_NAME__:$APP_VERSION
